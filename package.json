{
  "name": "se_project_spots",
  "version": "1.0.0",
  "description": "Spots is a simple web application that showcases a user profile along with a photo gallery. Users can view photos with descriptions, and they can interact with the \"like\" buttons for each photo. The app also includes functionality to edit the user's profile and add new posts.",
  "main": "index.js",
  "devDependencies": {
    "@babel/core": "7.18.9",
    "@babel/preset-env": "7.18.9",
    "autoprefixer": "10.4.7",
    "babel-loader": "8.2.5",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "6.7.1",
    "cssnano": "5.1.12",
    "gh-pages": "^3.1.0",
    "html-webpack-plugin": "5.5.0",
    "mini-css-extract-plugin": "2.6.1",
    "postcss-loader": "7.0.1",
    "webpack": "5.76.0",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "4.9.3"
  },
  "dependencies": {
    "core-js": "3.23.5"
  },
  "scripts": {
    "build": "rm -rf dist && webpack --mode production",
    "dev": "webpack serve --mode development",
    "predeploy": "npm run build",
   "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttonjee/se_project_spots.git"
  },
